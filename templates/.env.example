# ==========================================
# Multi-AI Workflow Environment Configuration
# Model snapshot: 2026-09-23
# ==========================================

# Local processing: Ollama / Qwen
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# Gemini / Antigravity
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API (optional; Codex clients normally manage their own auth)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_PRIMARY_MODEL=gpt-6-sol
OPENAI_LIGHT_MODEL=gpt-6-luna

# Anthropic API (optional; Claude Code normally manages its own auth)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-5-5
