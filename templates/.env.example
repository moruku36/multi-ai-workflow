# ==========================================
# Multi-AI Workflow Environment Configuration
# Model snapshot: 2026-09-29
# ==========================================

# Qwen Multimodal Colab
# Runtime/secrets are managed in the separate Colab repository:
# https://github.com/moruku36/qwen-multimodal-colab
# Store HF_TOKEN / TAVILY_API_KEY / BRAVE_API_KEY in Colab Secrets rather than this file.

# Gemini / Antigravity
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI API (optional; Codex clients normally manage their own auth)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_PRIMARY_MODEL=gpt-6-luna
OPENAI_ESCALATION_MODEL=gpt-6-sol

# Anthropic API (optional; Claude Code normally manages its own auth)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-5-5
# Effortはクライアント側で Medium を標準とし、必要時のみ変更する
